# Copy to .env and fill in. Never commit real keys.
GEMINI_API_KEY=
# Optional: override the Gemini model used for evidence analysis (default: gemini-4-hydrogen)
GEMINI_MODEL=
# Optional: thinking level (minimal, low, medium, high); lower is faster. Default: medium
GEMINI_THINKING=
# Optional: ElevenLabs key for the read-aloud button. Without it the button is hidden.
ELEVENLABS_API_KEY=
# Optional: override the voice or model (defaults: a premade voice, eleven_multilingual_v2)
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=
