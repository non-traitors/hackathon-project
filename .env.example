# Copy to .env and fill in. Never commit real keys.
GEMINI_API_KEY=
# Optional: override the Gemini model used for evidence analysis (default: gemini-4-hydrogen)
GEMINI_MODEL=
# Optional: thinking level (minimal, low, medium, high); lower is faster. Default: medium
GEMINI_THINKING=
# Optional: ElevenLabs key for voice input and read-aloud. Without it the voice controls are hidden.
# The key needs Text to Speech and Speech to Text access.
ELEVENLABS_API_KEY=
# Optional: override the voice or the text-to-speech model (defaults: a premade voice, eleven_v3)
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=
